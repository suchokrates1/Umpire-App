<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp"
    android:background="@color/score_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@color/score_background">

        <!-- Timer meczu -->
        <TextView
            android:id="@+id/textMatchTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorSecondary"
            android:gravity="center"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="01:23:45"/>

        <!-- Tryb gry (Tiebreak/Super Tiebreak) -->
        <TextView
            android:id="@+id/textGameMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textColor="@color/accent"
            android:gravity="center"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="Tie-break (do 7)"/>

        <!-- Nagłówki kolumn -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="2dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/scoreboard_player"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary"
                android:gravity="start"/>

            <TextView
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:text="@string/scoreboard_points"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary"
                android:gravity="center"/>

            <TextView
                android:id="@+id/headerSet1"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:text="@string/scoreboard_set1"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary"
                android:gravity="center"/>

            <TextView
                android:id="@+id/headerSet2"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:text="@string/scoreboard_set2"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary"
                android:gravity="center"/>

        </LinearLayout>

        <!-- Gracz 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:layout_marginTop="2dp">

            <!-- Ikona serwisu (piłka) - PRZED flagą -->
            <TextView
                android:id="@+id/textPlayer1ServerIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textSize="16sp"
                android:textColor="#CDDC39"
                android:layout_marginEnd="6dp"
                android:contentDescription="@string/player_serves_short"
                android:visibility="invisible"/>

            <!-- Flaga -->
            <TextView
                android:id="@+id/textPlayer1Flag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="20sp"
                android:layout_marginEnd="6dp"/>

            <!-- Nazwisko - auto-size -->
            <TextView
                android:id="@+id/textPlayer1Name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Player 1"
                android:textStyle="bold"
                android:textColor="@color/score_text"
                android:maxLines="1"
                android:ellipsize="end"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="14sp"
                app:autoSizeMaxTextSize="28sp"
                app:autoSizeStepGranularity="1sp"/>

            <!-- Punkty -->
            <TextView
                android:id="@+id/textPlayer1Points"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/accent"
                android:gravity="center"/>

            <!-- Set 1 -->
            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="wrap_content">
                
                <View
                    android:id="@+id/backgroundPlayer1Set1"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@android:color/transparent"/>
                
                <TextView
                    android:id="@+id/textPlayer1Set1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/score_text"
                    android:gravity="center"
                    android:paddingVertical="6dp"/>
            </FrameLayout>

            <!-- Set 2 -->
            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="wrap_content">
                
                <View
                    android:id="@+id/backgroundPlayer1Set2"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@android:color/transparent"/>
                
                <TextView
                    android:id="@+id/textPlayer1Set2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/score_text"
                    android:gravity="center"
                    android:paddingVertical="6dp"/>
            </FrameLayout>

        </LinearLayout>

        <!-- Gracz 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:layout_marginTop="2dp">

            <!-- Ikona serwisu (piłka) - PRZED flagą -->
            <TextView
                android:id="@+id/textPlayer2ServerIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textSize="16sp"
                android:textColor="#CDDC39"
                android:layout_marginEnd="6dp"
                android:contentDescription="@string/player_serves_short"
                android:visibility="invisible"/>

            <!-- Flaga -->
            <TextView
                android:id="@+id/textPlayer2Flag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="20sp"
                android:layout_marginEnd="6dp"/>

            <!-- Nazwisko - auto-size -->
            <TextView
                android:id="@+id/textPlayer2Name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Player 2"
                android:textStyle="bold"
                android:textColor="@color/score_text"
                android:maxLines="1"
                android:ellipsize="end"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="14sp"
                app:autoSizeMaxTextSize="28sp"
                app:autoSizeStepGranularity="1sp"/>

            <!-- Punkty -->
            <TextView
                android:id="@+id/textPlayer2Points"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/accent"
                android:gravity="center"/>

            <!-- Set 1 -->
            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="wrap_content">
                
                <View
                    android:id="@+id/backgroundPlayer2Set1"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@android:color/transparent"/>
                
                <TextView
                    android:id="@+id/textPlayer2Set1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/score_text"
                    android:gravity="center"
                    android:paddingVertical="6dp"/>
            </FrameLayout>

            <!-- Set 2 -->
            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="wrap_content">
                
                <View
                    android:id="@+id/backgroundPlayer2Set2"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@android:color/transparent"/>
                
                <TextView
                    android:id="@+id/textPlayer2Set2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/score_text"
                    android:gravity="center"
                    android:paddingVertical="6dp"/>
            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
