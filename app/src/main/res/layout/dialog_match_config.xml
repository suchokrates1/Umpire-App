<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:background="@drawable/dialog_rounded_bg">

<LinearLayout
    android:id="@+id/dialogContent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/match_config_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimaryVariant"
        android:gravity="center"
        android:layout_marginBottom="12dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/inputUmpireNameLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="@string/match_config_umpire_hint"
        app:boxBackgroundMode="outline">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editUmpireName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName"
            android:maxLines="1"/>

    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:id="@+id/layoutMixedDoubles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/match_config_mixed_title"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimaryVariant"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/match_config_mixed_desc"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"/>

        </LinearLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchMixedDoubles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:trackTintMode="src_in"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutManualStartTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/match_config_manual_datetime_title"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimaryVariant"/>

            <TextView
                android:id="@+id/textManualStartTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/match_config_manual_datetime_empty"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"/>

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSelectManualDateTime"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/match_config_set_datetime"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonClearManualDateTime"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/match_config_clear_datetime"
            android:visibility="gone"/>

    </LinearLayout>

    <!-- ==================== TB ONLY ==================== -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/tb_only_accent"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="@color/tb_only_card_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/match_config_tb_only"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/tb_only_accent"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/match_config_tb_only_desc"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchTiebreakOnly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:trackTintMode="src_in"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- TB Only: points selector -->
    <LinearLayout
        android:id="@+id/layoutTbOnlyPoints"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/match_config_tb_only_points"
            android:textSize="15sp"
            android:textColor="?attr/colorPrimaryVariant"/>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleTbOnlyPoints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTbOnly7"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="48dp"
                android:text="7"
                android:textSize="14sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTbOnly10"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="48dp"
                android:text="10"
                android:textSize="14sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>

        </com.google.android.material.button.MaterialButtonToggleGroup>

    </LinearLayout>

    <!-- ==================== MATCH FORMAT (hidden when TB Only) ==================== -->
    <LinearLayout
        android:id="@+id/layoutMatchFormat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/match_config_format_header"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"
        android:textAllCaps="true"
        android:letterSpacing="0.05"
        android:layout_marginBottom="8dp"/>

    <!-- Games per set -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/match_config_games_per_set"
            android:textSize="15sp"
            android:textColor="?attr/colorPrimaryVariant"/>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleGamesPerSet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGames3"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="48dp"
                android:text="3"
                android:textSize="14sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGames4"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="48dp"
                android:text="4"
                android:textSize="14sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGames5"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="48dp"
                android:text="5"
                android:textSize="14sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGames6"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="48dp"
                android:text="6"
                android:textSize="14sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>

        </com.google.android.material.button.MaterialButtonToggleGroup>

    </LinearLayout>

    <!-- Sets to win -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/match_config_sets_to_win"
            android:textSize="15sp"
            android:textColor="?attr/colorPrimaryVariant"/>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleSetsToWin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSets1"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="48dp"
                android:text="1"
                android:textSize="14sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSets2"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="48dp"
                android:text="2"
                android:textSize="14sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSets3"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="48dp"
                android:text="3"
                android:textSize="14sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>

        </com.google.android.material.button.MaterialButtonToggleGroup>

    </LinearLayout>

    <!-- Tiebreak points -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/match_config_tiebreak_to"
            android:textSize="15sp"
            android:textColor="?attr/colorPrimaryVariant"/>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleTiebreakPoints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTB7"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="48dp"
                android:text="7"
                android:textSize="14sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTB10"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="48dp"
                android:text="10"
                android:textSize="14sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>

        </com.google.android.material.button.MaterialButtonToggleGroup>

    </LinearLayout>

    <!-- Super tiebreak points -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/match_config_super_tiebreak_to"
            android:textSize="15sp"
            android:textColor="?attr/colorPrimaryVariant"/>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleSuperTiebreakPoints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSTB7"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="48dp"
                android:text="7"
                android:textSize="14sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSTB10"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="48dp"
                android:text="10"
                android:textSize="14sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>

        </com.google.android.material.button.MaterialButtonToggleGroup>

    </LinearLayout>

    </LinearLayout> <!-- /layoutMatchFormat -->

    <!-- ==================== OPTIONS ==================== -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="12dp"
        android:background="@color/divider"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/match_config_options_header"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"
        android:textAllCaps="true"
        android:letterSpacing="0.05"
        android:layout_marginBottom="8dp"/>

    <!-- No-Advantage -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_advantage_mode"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimaryVariant"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_advantage_desc"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginTop="2dp"/>

        </LinearLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchNoAdvantage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:trackTintMode="src_in"/>

    </LinearLayout>

    <!-- ==================== STATS MODE ==================== -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:background="@color/divider"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/match_config_stats_header"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"
        android:textAllCaps="true"
        android:letterSpacing="0.05"
        android:layout_marginBottom="8dp"/>

    <!-- Basic Mode Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBasicMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeColor="?attr/colorPrimary"
        app:strokeWidth="2dp"
        app:rippleColor="#402E7D32">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="⚡"
                android:textSize="24sp"
                android:gravity="center"
                android:background="@drawable/stats_mode_icon_bg_basic"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stats_mode_basic"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimaryVariant"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/stats_mode_basic_short"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"/>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textSize="28sp"
                android:textColor="?attr/colorPrimary"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Advanced Mode Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAdvancedMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeColor="?attr/colorSecondary"
        app:strokeWidth="2dp"
        app:rippleColor="#40FFC107">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="📊"
                android:textSize="24sp"
                android:gravity="center"
                android:background="@drawable/stats_mode_icon_bg_advanced"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stats_mode_advanced"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/tb_only_accent"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/stats_mode_advanced_short"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"/>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textSize="28sp"
                android:textColor="?attr/colorSecondary"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
</ScrollView>
