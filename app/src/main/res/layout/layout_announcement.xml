<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <!-- Icon + Title -->
    <TextView
        android:id="@+id/textAnnouncementIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="64sp"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/textAnnouncementTitle"
        app:layout_constraintVertical_chainStyle="packed"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/textAnnouncementTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="?attr/colorPrimary"
        app:layout_constraintTop_toBottomOf="@id/textAnnouncementIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/textAnnouncementMessage"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/textAnnouncementMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:gravity="center"
        android:alpha="0.7"
        app:layout_constraintTop_toBottomOf="@id/textAnnouncementTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/buttonAnnouncementContinue"
        android:layout_marginBottom="32dp"/>

    <!-- "Don't change sides" button – visible only for side_change announcements -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonAnnouncementSkipSideChange"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="@string/dont_change_sides"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:visibility="gone"
        app:strokeColor="#4CAF50"
        app:strokeWidth="2dp"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toTopOf="@id/buttonAnnouncementContinue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"/>

    <!-- Large "Continue" / "Dalej" button at the bottom -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonAnnouncementContinue"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:text="@string/continue_btn"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        style="@style/Widget.MaterialComponents.Button"
        android:backgroundTint="#4CAF50"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
