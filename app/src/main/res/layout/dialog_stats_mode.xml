<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/dialog_rounded_bg">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/stats_mode_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimaryVariant"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <!-- Basic Mode Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBasicMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeColor="?attr/colorPrimary"
        app:strokeWidth="2dp"
        app:rippleColor="#402E7D32">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <!-- Icon -->
            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="⚡"
                android:textSize="28sp"
                android:gravity="center"
                android:background="@drawable/stats_mode_icon_bg_basic"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stats_mode_basic"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimaryVariant"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/stats_mode_basic_short"
                    android:textSize="13sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:lineSpacingExtra="2dp"/>

            </LinearLayout>

            <!-- Arrow -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textSize="28sp"
                android:textColor="?attr/colorPrimary"
                android:layout_marginStart="8dp"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Advanced Mode Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAdvancedMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeColor="?attr/colorSecondary"
        app:strokeWidth="2dp"
        app:rippleColor="#40FFC107">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <!-- Icon -->
            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="📊"
                android:textSize="28sp"
                android:gravity="center"
                android:background="@drawable/stats_mode_icon_bg_advanced"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stats_mode_advanced"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/tb_only_accent"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/stats_mode_advanced_short"
                    android:textSize="13sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:lineSpacingExtra="2dp"/>

            </LinearLayout>

            <!-- Arrow -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textSize="28sp"
                android:textColor="?attr/colorSecondary"
                android:layout_marginStart="8dp"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- No-Advantage (Deciding Point) Option -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:background="?attr/dividerHorizontal"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_advantage_mode"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimaryVariant"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_advantage_desc"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginTop="2dp"/>

        </LinearLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchNoAdvantage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:trackTintMode="src_in"/>

    </LinearLayout>

</LinearLayout>
