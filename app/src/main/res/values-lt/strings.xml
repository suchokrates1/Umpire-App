    <string name="tutorial_banner_message">A short guided match: court, players, scoring, change of ends, and how to finish after an injury.</string>
    <string name="tutorial_demo_tournament">Mokymas</string>
    <string name="tutorial_demo_player1_first">Anna</string>
    <string name="tutorial_demo_player1_last">Costa</string>
